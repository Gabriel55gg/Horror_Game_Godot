[sub_resource type="GDScript" id="GDScript_4arys"]
script/source = "extends CharacterBody3D

@export var move_speed: float = 4.0
@export var run_speed: float = 7.0
@export var jump_velocity: float = 4.5
@export var mouse_sensitivity: float = 0.002
@export var gravity: float = 9.8
@export var freecam_speed: float = 6.0

@onready var normal_camera: Camera3D = $Camera3D
@onready var free_camera: Camera3D = $FreeCamera3D

var is_freecam_active: bool = false
var is_caught: bool = false # Nova variável para bloquear o jogador ao ser apanhado
var caught_monster: Node3D = null

func _ready() -> void:
	if free_camera:
		free_camera.current = false
	if normal_camera:
		normal_camera.current = true
	
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

func _unhandled_input(event: InputEvent) -> void:
	# Se foi apanhado, bloqueia todos os inputs normais (exceto ver o monstro)
	if is_caught:
		return

	if event is InputEventKey and event.pressed and event.keycode == KEY_ESCAPE:
		if Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
			Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		else:
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

	if event is InputEventKey and event.pressed and event.keycode == KEY_T:
		is_freecam_active = not is_freecam_active
		
		if is_freecam_active:
			free_camera.global_transform = normal_camera.global_transform
			free_camera.current = true
			print(\"DEBUG: Câmara fantasma ATIVADA (Tecla T).\")
		else:
			normal_camera.current = true
			print(\"DEBUG: Câmara fantasma DESATIVADA.\")

	if event is InputEventMouseMotion and (Input.mouse_mode == Input.MOUSE_MODE_CAPTURED):
		if is_freecam_active:
			free_camera.rotate_y(-event.relative.x * mouse_sensitivity)
			free_camera.rotate_object_local(Vector3.RIGHT, -event.relative.y * mouse_sensitivity)
		else:
			rotate_y(-event.relative.x * mouse_sensitivity)
			if normal_camera:
				normal_camera.rotate_object_local(Vector3.RIGHT, -event.relative.y * mouse_sensitivity)
				normal_camera.rotation.x = clamp(normal_camera.rotation.x, deg_to_rad(-80), deg_to_rad(80))

func _physics_process(delta: float) -> void:
	# Se foi apanhado, trava o movimento e força a câmara a olhar fixamente para o monstro
	if is_caught:
		velocity = Vector3.ZERO
		move_and_slide()
		
		if caught_monster and normal_camera:
			# Faz a câmara do jogador olhar diretamente para o monstro que o apanhou
			normal_camera.look_at(caught_monster.global_position + Vector3(0, 1.0, 0), Vector3.UP)
		return

	if is_freecam_active:
		_handle_freecam_movement(delta)
		return

	if not is_on_floor():
		velocity.y -= gravity * delta

	if Input.is_key_pressed(KEY_SPACE) and is_on_floor():
		velocity.y = jump_velocity

	var current_speed = run_speed if Input.is_key_pressed(KEY_SHIFT) else move_speed

	var input_dir = Vector2.ZERO
	if Input.is_key_pressed(KEY_W):
		input_dir.y -= 1
	if Input.is_key_pressed(KEY_S):
		input_dir.y += 1
	if Input.is_key_pressed(KEY_A):
		input_dir.x -= 1
	if Input.is_key_pressed(KEY_D):
		input_dir.x += 1
		
	var direction = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	
	if direction:
		velocity.x = direction.x * current_speed
		velocity.z = direction.z * current_speed
	else:
		velocity.x = move_toward(velocity.x, 0, current_speed)
		velocity.z = move_toward(velocity.z, 0, current_speed)

	move_and_slide()

func _handle_freecam_movement(delta: float) -> void:
	var input_dir = Vector3.ZERO
	if Input.is_key_pressed(KEY_W):
		input_dir -= free_camera.transform.basis.z
	if Input.is_key_pressed(KEY_S):
		input_dir += free_camera.transform.basis.z
	if Input.is_key_pressed(KEY_A):
		input_dir -= free_camera.transform.basis.x
	if Input.is_key_pressed(KEY_D):
		input_dir += free_camera.transform.basis.x
		
	if Input.is_key_pressed(KEY_SPACE):
		input_dir += Vector3.UP
	if Input.is_key_pressed(KEY_CTRL):
		input_dir += Vector3.DOWN

	input_dir = input_dir.normalized()
	free_camera.global_position += input_dir * freecam_speed * delta

func got_caught_by_monster(monster_node: Node3D) -> void:
	if is_caught:
		return
		
	is_caught = true
	caught_monster = monster_node
	
	# Desativa a câmara livre se estivesse ativa para focar no susto
	is_freecam_active = false
	if normal_camera:
		normal_camera.current = true
		
	print(\"DEBUG: O monstro apanhou o jogador! Ecrã travado nele e movimentos bloqueados.\")
	
	# Opcional: Libertar o rato para ver o menu de Game Over se quiseres
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
"

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_ioeao"]

[sub_resource type="GDScript" id="GDScript_xtbk7"]
script/source = "extends CharacterBody3D

@export var speed: float = 2.8
@export var attack_distance: float = 1.8
@export var vision_range: float = 20.0
@export var wander_radius: float = 12.0

@onready var nav_agent: NavigationAgent3D = $NavigationAgent3D
@onready var anim_player: AnimationPlayer = $Skeleton3D/AnimationPlayer
@onready var scream_player: AudioStreamPlayer3D = $AudioStreamPlayer3D
@onready var ray_cast: RayCast3D = $RayCast3D

const ANIM_RUN = \"mixamo_com\"
const ANIM_ATTACK = \"attack\"
const ANIM_OLD_MAN = \"old man idle\"
const ANIM_SAD_IDLE = \"sad idle\"

enum AIState { IDLE, CHASING, INVESTIGATING, WANDERING }
var current_state: AIState = AIState.IDLE

var player: Node3D = null
var is_attacking: bool = false
var idle_timer: float = 0.0
var next_random_idle_time: float = 40.0
var wander_pause_timer: float = 0.0
var target_wander_pause: float = 10.0
var is_playing_sad_idle: bool = false
var sad_timer: float = 0.0

var stuck_timer: float = 0.0
var last_position: Vector3 = Vector3.ZERO

func _ready() -> void:
	player = get_tree().get_first_node_in_group(\"player\")
	if player:
		print(\"DEBUG: Jogador encontrado com sucesso pelo monstro!\")
		
	current_state = AIState.IDLE
	nav_agent.target_desired_distance = 1.0
	nav_agent.path_desired_distance = 0.5
	
	if ray_cast:
		ray_cast.enabled = true
		
	_reset_idle_timer()
	last_position = global_position

func _physics_process(delta: float) -> void:
	if is_attacking:
		velocity = Vector3.ZERO
		return

	if not player:
		return

	# --- SISTEMA DE DESBLOQUEIO DE PAREDES / CSG ---
	# Se estiver a tentar perseguir ou patrulhar mas não se estiver a deslocar (preso contra a parede)
	if current_state == AIState.CHASING or current_state == AIState.WANDERING:
		if is_on_wall() or global_position.distance_to(last_position) < 0.04:
			stuck_timer += delta
			# Se ficar 0.8 segundos encastrado na parede sem conseguir avançar
			if stuck_timer >= 0.8:
				stuck_timer = 0.0
				print(\"DEBUG: Colisão com parede detetada! A forçar recálculo de rota.\")
				if current_state == AIState.CHASING:
					# Força o NavigationAgent a recalcular a malha contornando o obstáculo
					nav_agent.target_position = player.global_position
				else:
					_choose_new_wander_target()
		else:
			stuck_timer = 0.0
		last_position = global_position

	var distance_to_player = global_position.distance_to(player.global_position)

	if distance_to_player <= attack_distance:
		trigger_attack()
		return

	var can_see = can_see_player_through_walls()

	if can_see:
		if current_state != AIState.CHASING:
			print(\"DEBUG: Viu-te! A iniciar perseguição e a correr.\")
		current_state = AIState.CHASING
		is_playing_sad_idle = false
		nav_agent.target_position = player.global_position
	else:
		if current_state == AIState.CHASING and nav_agent.is_navigation_finished():
			print(\"DEBUG: Perdeu-te de vista. A iniciar investigação e regresso...\")
			_start_investigation_and_wander()

	match current_state:
		AIState.CHASING:
			_process_chasing()
		AIState.INVESTIGATING:
			velocity = Vector3.ZERO
			if not is_playing_sad_idle:
				_play_sad_idle_for_5_seconds()
		AIState.WANDERING:
			_process_wandering(delta)
		AIState.IDLE:
			velocity = Vector3.ZERO
			_handle_idle_behavior(delta)

func _process_chasing() -> void:
	if anim_player and anim_player.current_animation != ANIM_RUN:
		anim_player.play(ANIM_RUN)

	# Atualiza dinamicamente a posição do alvo para o jogador
	nav_agent.target_position = player.global_position

	if not nav_agent.is_navigation_finished():
		var next_path_position: Vector3 = nav_agent.get_next_path_position()
		var new_velocity: Vector3 = (next_path_position - global_position).normalized() * speed

		velocity.x = new_velocity.x
		velocity.z = new_velocity.z

		_look_at_target(next_path_position)
		move_and_slide()
		
		# Verifica se colidiu lateralmente com uma parede e aplica um leve deslize corretivo
		for i in get_slide_collision_count():
			var collision = get_slide_collision(i)
			if collision.get_normal().dot(Vector3.UP) < 0.1: # É uma parede lateral
				# Dá um empurrãozinho para fora da quina da CSG
				global_position += collision.get_normal() * 0.02

func _process_wandering(delta: float) -> void:
	if not nav_agent.is_navigation_finished():
		if anim_player and anim_player.current_animation != ANIM_RUN:
			anim_player.play(ANIM_RUN)

		var next_path_position: Vector3 = nav_agent.get_next_path_position()
		var new_velocity: Vector3 = (next_path_position - global_position).normalized() * (speed * 0.75)

		velocity.x = new_velocity.x
		velocity.z = new_velocity.z

		_look_at_target(next_path_position)
		move_and_slide()
	else:
		velocity.x = 0
		velocity.z = 0
		
		_handle_idle_behavior(delta)
		
		wander_pause_timer += delta
		if wander_pause_timer >= target_wander_pause:
			_choose_new_wander_target()

func _start_investigation_and_wander() -> void:
	current_state = AIState.INVESTIGATING
	velocity = Vector3.ZERO
	
	_play_sad_idle_for_5_seconds()
	
	await get_tree().create_timer(15.0).timeout
	
	if current_state == AIState.INVESTIGATING:
		print(\"DEBUG: A começar a patrulhar/vaguear pela casa.\")
		current_state = AIState.WANDERING
		_reset_idle_timer()
		_choose_new_wander_target()

func _play_sad_idle_for_5_seconds() -> void:
	is_playing_sad_idle = true
	sad_timer = 0.0
	if anim_player:
		anim_player.play(ANIM_SAD_IDLE)

func _choose_new_wander_target() -> void:
	wander_pause_timer = 0.0
	target_wander_pause = randf_range(10.0, 15.0)
	
	var random_offset = Vector3(randf_range(-wander_radius, wander_radius), 0, randf_range(-wander_radius, wander_radius))
	var candidate_pos = global_position + random_offset
	nav_agent.target_position = candidate_pos

func _handle_idle_behavior(delta: float) -> void:
	if not anim_player:
		return
		
	if is_playing_sad_idle:
		sad_timer += delta
		if sad_timer >= 5.0:
			is_playing_sad_idle = false
			_reset_idle_timer()
			anim_player.play(ANIM_OLD_MAN)
		return
		
	idle_timer += delta
	
	if idle_timer >= next_random_idle_time:
		_play_sad_idle_for_5_seconds()
	else:
		if anim_player.current_animation != ANIM_OLD_MAN:
			anim_player.play(ANIM_OLD_MAN)

func _reset_idle_timer() -> void:
	idle_timer = 0.0
	next_random_idle_time = randf_range(40.0, 60.0)

func _look_at_target(target_pos: Vector3) -> void:
	var look_target = Vector3(target_pos.x, global_position.y, target_pos.z)
	if global_position.distance_to(look_target) > 0.1:
		look_at(look_target, Vector3.UP)
		rotate_y(deg_to_rad(180))

func can_see_player_through_walls() -> bool:
	if not player or not ray_cast:
		return false
		
	if global_position.distance_to(player.global_position) > vision_range:
		return false
		
	ray_cast.target_position = ray_cast.to_local(player.global_position + Vector3(0, 1.0, 0))
	ray_cast.force_raycast_update()
	
	if ray_cast.is_colliding():
		var collider = ray_cast.get_collider()
		if collider == player:
			return true
			
	return false

func trigger_attack() -> void:
	if is_attacking:
		return
		
	is_attacking = true
	velocity = Vector3.ZERO
	
	if anim_player:
		anim_player.stop()
		anim_player.play(ANIM_ATTACK)
		
	if scream_player:
		scream_player.play()
	
	if player and player.has_method(\"got_caught_by_monster\"):
		player.got_caught_by_monster(self)
"

