[sub_resource type="GDScript" id="GDScript_l63jx"]
script/source = "extends Node3D

@export var angulo_abertura: float = 90.0 # Ângulo em graus quando aberta
@export var velocidade: float = 5.0      # Velocidade da animação

var aberta: float = false
var pode_interagir: bool = false
var rotacao_inicial_y: float = 0.0

@onready var area_interacao: Area3D = $Area3D

func _ready() -> void:
	rotacao_inicial_y = rotation_degrees.y
	
	# Conecta os sinais da área para saber quando o jogador está perto
	area_interacao.body_entered.connect(_on_body_entered)
	area_interacao.body_exited.connect(_on_body_exited)

func _process(delta: float) -> void:
	# Pressionar a tecla 'E' para abrir ou fechar
	if pode_interagir and Input.is_action_just_pressed(\"ui_accept\"): # Ou crie uma ação \"interact\" no Input Map
		aberta = !aberta

	# Anima a rotação suavemente usando lerp
	var angulo_alvo = rotacao_inicial_y + (angulo_abertura if aberta else 0.0)
	rotation_degrees.y = lerp(rotation_degrees.y, angulo_alvo, delta * velocidade)

func _on_body_entered(body: Node) -> void:
	if body.is_in_group(\"player\") or body.name == \"CharacterBody3D\":
		pode_interagir = true

func _on_body_exited(body: Node) -> void:
	if body.is_in_group(\"player\") or body.name == \"CharacterBody3D\":
		pode_interagir = false
"

