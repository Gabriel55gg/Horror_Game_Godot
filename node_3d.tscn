[sub_resource type="GDScript" id="GDScript_4arys"]
script/source = "extends CharacterBody3D

const WALK_SPEED = 5.0
const SPRINT_SPEED = 8.5
const JUMP_VELOCITY = 6.0
const MOUSE_SENSITIVITY = 0.003

@onready var camera = $Camera3D
@onready var flashlight = $Camera3D/SpotLight3D

var gravity = ProjectSettings.get_setting(\"physics/3d/default_gravity\")

func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)

func _unhandled_input(event):
	# Rotação da câmara com o rato
	if event is InputEventMouseMotion:
		rotate_y(-event.relative.x * MOUSE_SENSITIVITY)
		camera.rotate_x(-event.relative.y * MOUSE_SENSITIVITY)
		camera.rotation.x = clamp(camera.rotation.x, deg_to_rad(-89), deg_to_rad(89))
	
	# Libertar o rato com a tecla ESC
	if event.is_action_pressed(\"ui_cancel\"):
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		
	# Alternar lanterna (Tecla F)
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_F:
			if flashlight:
				flashlight.visible = !flashlight.visible

func _physics_process(delta):
	# Gravidade
	if not is_on_floor():
		velocity.y -= gravity * delta

	# Salto (Espaço)
	if (Input.is_action_just_pressed(\"ui_accept\") or Input.is_key_pressed(KEY_SPACE)) and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# Correr (Shift)
	var current_speed = WALK_SPEED
	if Input.is_key_pressed(KEY_SHIFT):
		current_speed = SPRINT_SPEED

	# Movimento WASD
	var input_dir = Vector2.ZERO
	if Input.is_key_pressed(KEY_D):
		input_dir.x += 1
	if Input.is_key_pressed(KEY_A):
		input_dir.x -= 1
	if Input.is_key_pressed(KEY_S):
		input_dir.y += 1
	if Input.is_key_pressed(KEY_W):
		input_dir.y -= 1
	
	input_dir = input_dir.normalized()

	var direction = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	if direction:
		velocity.x = direction.x * current_speed
		velocity.z = direction.z * current_speed
	else:
		velocity.x = move_toward(velocity.x, 0, current_speed)
		velocity.z = move_toward(velocity.z, 0, current_speed)

	move_and_slide()
"

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_ioeao"]

[sub_resource type="GDScript" id="GDScript_jsk3o"]
script/source = "extends CharacterBody3D

@export var speed: float = 3.5
@export var target_player: Node3D

@onready var nav_agent: NavigationAgent3D = $NavigationAgent3D

var gravity: float = ProjectSettings.get_setting(\"physics/3d/default_gravity\")

func _ready() -> void:
	await get_tree().physics_frame
	await get_tree().physics_frame
	if target_player:
		nav_agent.target_position = target_player.global_position

func _physics_process(delta: float) -> void:
	if not is_on_floor():
		velocity.y -= gravity * delta

	if target_player:
		nav_agent.target_position = target_player.global_position
		
		# Imprime na consola a distância até ao próximo ponto para sabermos se o mapa está a responder
		var next_pos = nav_agent.get_next_path_position()
		var dist = global_position.distance_to(next_pos)
		
		var dir = (next_pos - global_position)
		dir.y = 0
		
		if dir.length() > 0.1:
			dir = dir.normalized()
			velocity.x = dir.x * speed
			velocity.z = dir.z * speed
			
			var target_rot = atan2(-dir.x, -dir.z)
			rotation.y = lerp_angle(rotation.y, target_rot, delta * 10.0)
		else:
			velocity.x = move_toward(velocity.x, 0, speed)
			velocity.z = move_toward(velocity.z, 0, speed)

	move_and_slide()
"

