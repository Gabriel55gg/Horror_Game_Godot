[gd_scene format=3 uid="uid://c762nv8wkt48e"]

[sub_resource type="GDScript" id="GDScript_wrbjf"]
resource_name = "main_menu.gd"
script/source = "extends Control

# Caminho para a cena principal do teu jogo (onde está a casa, o jogador e o monstro)
@export_file(\"*.tscn\") var game_scene_path: String = \"res://cena_principal.tscn\" # Altera para o nome exato da tua cena de jogo

@onready var btn_play: Button = $VBoxContainer/BtnPlay
@onready var btn_quit: Button = $VBoxContainer/BtnQuit

func _ready() -> void:
	# Certifica-te de que o rato fica visível e destravado no menu principal
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	
	# Conecta os sinais dos botões via código de forma segura
	if btn_play:
		btn_play.pressed.connect(_on_play_pressed)
	if btn_quit:
		btn_quit.pressed.connect(_on_quit_pressed)

func _on_play_pressed() -> void:
	print(\"DEBUG: A carregar o jogo...\")
	# Muda para a cena principal do jogo
	var error = get_tree().change_scene_to_file(game_scene_path)
	if error != OK:
		print(\"ERRO: Não foi possível carregar a cena do jogo em: \", game_scene_path)

func _on_quit_pressed() -> void:
	print(\"DEBUG: A sair do jogo.\")
	get_tree().quit()
"

